# Copy this file to .env and fill in your values.
# .env is gitignored — never commit your real API key.

# -------------------------------------------------------------------
# Required
# -------------------------------------------------------------------

# Google Gemini API key (free tier: 1,500 requests/day)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# TMDB API key — used to verify and enrich Gemini classifications
# with canonical titles and years. Optional but recommended.
# Get one (free) at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# -------------------------------------------------------------------
# Paths — defaults shown below (TrueNAS layout)
# Change these to match your server's directory structure
# -------------------------------------------------------------------

# Root of your Plex media library
BASE_MEDIA_DIR=/mnt/tank/media

# Staging folder where Syncthing drops new files (rsync'd by smart-sync.sh)
SYNC_DIR=/mnt/tank/media/Sync

# Syncthing source directory (smart-sync.sh reads from here)
SYNC_SRC=/mnt/tank/sync

# Destination for smart-sync.sh (should match SYNC_DIR above)
SYNC_DST=/mnt/tank/media/Sync

# -------------------------------------------------------------------
# Notifications (optional — leave blank to disable)
# -------------------------------------------------------------------

# Discord webhook URL for run summary notifications
# Create one at: Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=

# ntfy topic URL for push notifications (e.g. https://ntfy.sh/your-topic)
# Self-hosted or free cloud tier at ntfy.sh
NTFY_URL=
